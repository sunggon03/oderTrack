{
  "rules": {
    "staff": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "settings": {
      ".read": true,
      ".write": "(auth != null && root.child('staff').child(auth.uid).exists())"
    },
    "menu": {
      ".read": true,
      ".write": "(auth != null && root.child('staff').child(auth.uid).exists())"
    },
    "meta": {
      ".read": "(auth != null && root.child('staff').child(auth.uid).exists())",
      ".write": "(auth != null && root.child('staff').child(auth.uid).exists())"
    },
    "status": {
      ".write": "(auth != null && root.child('staff').child(auth.uid).exists())",
      "$id": {
        ".read": true
      }
    },
    "orders": {
      ".read": "(auth != null && root.child('staff').child(auth.uid).exists())",
      ".write": "(auth != null && root.child('staff').child(auth.uid).exists())",
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['table','nick','items','total','status','createdAt']) && ((auth != null && root.child('staff').child(auth.uid).exists()) || newData.child('status').val() === 'unpaid')",
        "table": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10"
        },
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20"
        },
        "total": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000"
        },
        "people": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99 && newData.val() % 1 === 0"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().matches(/^(unpaid|cooking|done|cancelled)$/)"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && ((auth != null && root.child('staff').child(auth.uid).exists()) || (newData.val() >= now - 60000 && newData.val() <= now + 60000))"
        },
        "paidAt": {
          ".validate": "(auth != null && root.child('staff').child(auth.uid).exists()) && newData.isNumber()"
        },
        "doneAt": {
          ".validate": "(auth != null && root.child('staff').child(auth.uid).exists()) && newData.isNumber()"
        },
        "seq": {
          ".validate": "(auth != null && root.child('staff').child(auth.uid).exists()) && newData.isNumber()"
        },
        "items": {
          ".validate": "newData.hasChildren()",
          "$i": {
            ".validate": "$i.matches(/^[12]?[0-9]$/) && newData.hasChildren(['id','name','price','qty']) && newData.child('id').isString() && ((auth != null && root.child('staff').child(auth.uid).exists()) || (root.child('menu').child(newData.child('id').val()).exists() && root.child('menu').child(newData.child('id').val()).child('price').val() === newData.child('price').val() && root.child('menu').child(newData.child('id').val()).child('name').val() === newData.child('name').val() && root.child('menu').child(newData.child('id').val()).child('soldout').val() !== true))",
            "id": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 60"
            },
            "price": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500000"
            },
            "qty": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99 && newData.val() % 1 === 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
